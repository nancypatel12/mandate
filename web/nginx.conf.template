# The console is the human's seat: read, sign a mandate, revoke one, start the agent.
# The admin token lives here (from the environment), never in the browser bundle.
# It is added to exactly two calls: sign and revoke.
#
# Every write must carry "X-Mandate-Console: 1". A browser won't send a custom header
# across origins without a preflight, and nothing here answers one, so another site
# open in the same browser can't sign or revoke.
map "$request_method:$http_x_mandate_console" $bad_write {
    default   1;
    ~^GET:    0;
    ~^HEAD:   0;
    "POST:1"  0;
}

server {
    listen 80;
    root /usr/share/nginx/html;

    if ($bad_write) { return 403; }

    location / {
        try_files $uri /index.html;
    }

    # Sign (POST) and list (GET).
    location = /api/mandates {
        limit_except GET POST { deny all; }
        proxy_set_header Authorization "Bearer ${MANDATE_ADMIN_TOKEN}";
        proxy_pass http://mandate:8000/mandates$is_args$args;
    }

    # Quoted: nginx reads an unquoted {26} as a block.
    location ~ "^/api/mandates/mnd_[0-9A-HJKMNP-TV-Z]{26}/revoke$" {
        limit_except POST { deny all; }
        rewrite ^/api/(.*)$ /$1 break;
        proxy_set_header Authorization "Bearer ${MANDATE_ADMIN_TOKEN}";
        proxy_pass http://mandate:8000;
    }

    location /api/ {
        limit_except GET { deny all; }
        proxy_set_header Authorization "";
        proxy_pass http://mandate:8000/;
    }

    # The agent runner: start a run, watch a run. No admin token goes here.
    location = /agent/runs {
        limit_except POST { deny all; }
        proxy_set_header Authorization "";
        proxy_pass http://runner:8001/runs;
    }

    location /agent/ {
        limit_except GET { deny all; }
        proxy_set_header Authorization "";
        proxy_pass http://runner:8001/;
    }
}
