# Copy to .env and fill in. Never commit .env.

# ── Mandate service ──────────────────────────────────────────────────
# Signs mandate tokens (HS256). At least 32 bytes. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MANDATE_SIGNING_KEY=

# Bearer token for the human-only endpoints: issue and revoke. The console's proxy
# adds it to those two calls. The browser and the agent never get it. Generate it like the signing key.
MANDATE_ADMIN_TOKEN=

# SQLite file holding mandates, revocation state, spend counters and the ledger.
MANDATE_DB=./data/mandate.db

# ── PayPal (sandbox only, free) ──────────────────────────────────────
# 1. Log in at https://developer.paypal.com (any PayPal account works; no card needed).
# 2. Apps & Credentials → make sure the toggle says "Sandbox" → Create App (type: Merchant).
# 3. In the app's settings, tick "Save payment methods" (needed for the vault).
# 4. Copy the Client ID and Secret here.
# 5. Later, `mandate fund` prints a link: log in there with your sandbox *Personal* account
#    (Testing Tools → Sandbox Accounts), never your real PayPal login.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Do not change. MANDATE refuses to start against any other host.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ── Agent LLM (free; any OpenAI-compatible provider) ───────────────────
# Groq: sign up at https://console.groq.com (no card) → API Keys → Create.
# Only the live agent uses this; the demo and red team make no LLM calls.
# To switch providers, change only these three lines.
# Gemini fallback: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# ── Product catalog (free) ───────────────────────────────────────────
# Channel3: sign up at https://trychannel3.com/sign-up/developer → dashboard → API key.
# Free tier: 1,000 searches/month. Do not add a payment method; when credits run
# out the API returns 402 and MANDATE falls back to the bundled static catalog.
CHANNEL3_API_KEY=
